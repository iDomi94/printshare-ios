    },
    "errLink": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Link kann PocketPrint3D nichts anfangen. Unterstützt: Printables, Thingiverse, direkte Datei-Links."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
