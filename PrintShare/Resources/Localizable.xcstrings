        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model has no printable files (STL, 3MF, OBJ, STEP)."
          }
        }
      }
    },
    "errNoPrint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
