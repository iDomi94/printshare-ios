    "errBridgeCode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Code kennt die Cloud nicht (oder er ist abgelaufen) – die Brücke zeigt nach 10 Minuten einen neuen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud doesn't know this code (or it expired) – the bridge shows a new one after 10 minutes."
          }
        }
      }
    },
    "errBridgeKey": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Brücke hat keinen Schlüssel gemeldet – bitte aktualisiere sie."
          }
