    "ownCameraEditHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen = unverändert. RTSP-Adresse (z. B. Tapo, Reolink) oder Webcam-Adresse (http://…); wird verschlüsselt an die Brücke geschickt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty = unchanged. An RTSP address (e.g. Tapo, Reolink) or a webcam address (http://…); sent encrypted to the bridge."
          }
        }
      }
    },
    "ownCameraHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statt der eingebauten Kamera eine IP-Kamera nutzen: RTSP-Adresse (z. B. Tapo, Reolink) oder Webcam-Adresse (http://…). Wird verschlüsselt an die Brücke geschickt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
