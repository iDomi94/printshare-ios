    "bridgeGuide": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Brücke? Anleitung für Einsteiger"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bridge yet? Guide for beginners"
          }
        }
      }
    },
    "bridgeGuideSub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Raspberry Pi für etwa 60 € – fertiges Image: Karte rein, Kabel dran, fertig"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raspberry Pi for about €60 – ready-made image: card in, cable on, done"
          }
        }
      }
    },
    "bridgeIntro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Brücke ist ein kleiner Rechner bei dir zu Hause, der ständig läuft – am einfachsten ein Raspberry Pi mit unserem fertigen Image, oder dein eigener PocketPrint3D-Server (Unraid, Home Assistant, Docker). Ist sie mit deinem Konto verbunden, erreichst du deine Drucker auch unterwegs; nichts muss im Router freigegeben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bridge is a small computer at home that is always on – easiest is a Raspberry Pi with our ready-made image, or your own PocketPrint3D server (Unraid, Home Assistant, Docker). Once it is connected to your account, you reach your printers from anywhere; nothing has to be opened in your router."
          }
        }
      }
    },
    "bridgeLanFree": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf ein Konto – tippen zum Verbinden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for an account – tap to connect"
          }
        }
      }
    },
    "bridgeLanHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine fertige PocketPrint3D-Brücke (Raspberry Pi) im selben WLAN erscheint hier – ein Tipp verbindet sie mit deinem Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ready-made PocketPrint3D bridge (Raspberry Pi) on the same Wi-Fi shows up here – one tap connects it to your account."
          }
        }
      }
    },
    "bridgeLanMine": {
      "localizations": {
        "de": {
