    "bridgeLanNoWifi": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy ist gerade nicht in einem WLAN – verbinde es mit dem WLAN zu Hause, um die Brücke zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone isn't on a Wi-Fi right now – connect it to your home Wi-Fi to find the bridge."
