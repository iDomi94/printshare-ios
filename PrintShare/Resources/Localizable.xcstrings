        }
      }
    },
    "errNotStarted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist auf dem Drucker, aber der Druck ist nicht angelaufen. Bitte am Display des Druckers starten oder erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
