      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerWorld erlaubt Downloads nur mit deinem Konto: lade das 3MF auf makerworld.com und teile es mit PocketPrint3D."
          }
        },
        "en": {
          "stringUnit": {
