{
  "sourceLanguage": "de",
  "strings": {
    "about": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über PocketPrint3D"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About PocketPrint3D"
          }
        }
      }
    },
    "aboutText": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source (MIT). Slicen mit OrcaSlicer auf deinem eigenen Server – keine Cloud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source (MIT). Slicing with OrcaSlicer on your own server – no cloud."
          }
        }
      }
    },
    "aboutTextCloud": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source (MIT). Die Druckberechnung läuft mit OrcaSlicer in der PocketPrint3D Cloud (EU); an den Drucker sendet dein Handy direkt im WLAN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source (MIT). Prints are prepared with OrcaSlicer in the PocketPrint3D Cloud (EU); your phone sends them to the printer directly on your Wi-Fi."
          }
        }
      }
    },
    "aboutTextCloudWeb": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Source (MIT). Die Druckberechnung läuft mit OrcaSlicer in der PocketPrint3D Cloud (EU); an den Drucker geht der Druck über deine Brücke zu Hause oder über die App im WLAN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open source (MIT). Prints are prepared with OrcaSlicer in the PocketPrint3D Cloud (EU); they reach the printer through your bridge at home or through the app on the Wi-Fi."
          }
        }
      }
    },
