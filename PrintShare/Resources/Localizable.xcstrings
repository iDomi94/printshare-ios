    "cloudIntro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne eigenen Server: gesucht und geslict wird in der PocketPrint3D Cloud, gedruckt wird über dein WLAN zu Hause. Kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No server of your own needed: search and slicing happen in the PocketPrint3D cloud, printing goes over your Wi-Fi at home. Free."
          }
        }
      }
    },
