    "bridgeAccessHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausfüllen, um Adresse, Passwort oder API-Key zu ändern – sie werden verschlüsselt an die Brücke geschickt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only fill in to change the address, password or API key – they are sent encrypted to the bridge."
          }
        }
      }
    },
    "bridgeAddHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird über die Brücke „{bridge}“ hinzugefügt. Adresse und Passwort werden verschlüsselt, nur die Brücke kann sie lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added through the bridge “{bridge}”. Address and password are encrypted; only the bridge can read them."
          }
        }
      }
    },
    "bridgeAddPrinter": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drucker über die Brücke hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a printer through the bridge"
          }
        }
      }
    },
    "bridgeAddressHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse des Druckers im Netzwerk der Brücke, z. B. 192.168.1.50."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer's address in the bridge's network, e.g. 192.168.1.50."
          }
        }
      }
    },
    "bridgeCode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code der Brücke"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code of the bridge"
