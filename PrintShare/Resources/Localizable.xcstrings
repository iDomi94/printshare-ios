    "errBusy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker ist noch beschäftigt. Warte, bis der aktuelle Druck fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer is still busy. Wait until the current print has finished."
          }
        }
      }
    },
    "errDownload": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Modells ist fehlgeschlagen. Bitte später erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading the model failed. Please try again later."
          }
        }
      }
    },
    "errFileType": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Dateityp wird nicht unterstützt. Möglich sind STL, 3MF, OBJ und STEP."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file type is not supported. Use STL, 3MF, OBJ or STEP."
          }
        }
      }
    },
    "errLink": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit diesem Link kann PrintShare nichts anfangen. Unterstützt: Printables, Thingiverse, direkte Datei-Links."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PrintShare can’t use this link. Supported: Printables, Thingiverse, direct file links."
          }
        }
      }
    },
    "errNoFiles": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell enthält keine druckbaren Dateien (STL, 3MF, OBJ, STEP)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model has no printable files (STL, 3MF, OBJ, STEP)."
          }
        }
      }
    },
    "errNotFound": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell wurde nicht gefunden oder ist nicht öffentlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model was not found or is not public."
          }
        }
      }
    },
    "errNotStarted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist auf dem Drucker, aber der Druck ist nicht angelaufen. Bitte am Display des Druckers starten oder erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is on the printer, but the print did not start. Start it on the printer's screen or try again."
          }
        }
      }
    },
    "errOffline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist nicht erreichbar. Bist du im selben Netz oder mit Tailscale verbunden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is not reachable. Are you on the same network or connected to Tailscale?"
          }
        }
      }
    },
    "errPrinterOffline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker ist nicht erreichbar. Ist er eingeschaltet und im Netz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer is not reachable. Is it switched on and on the network?"
          }
        }
      }
    },
    "errProfile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Druckprofil fehlt auf dem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A print profile is missing on the server."
          }
        }
      }
    },
    "errRefused": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker hat den Start abgelehnt – z. B. weil er beschäftigt ist oder die Datei für ein anderes Modell geslict wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer refused to start – e.g. because it is busy or the file was sliced for a different model."
          }
        }
      }
    },
    "errServerOld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein PrintShare-Server kennt diese Funktion noch nicht. Aktualisiere ihn auf Version 0.6.0 oder neuer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PrintShare server does not have this feature yet. Update it to version 0.6.0 or newer."
          }
        }
      }
    },
    "errSlice": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Slicen ist fehlgeschlagen. Oft ist das Modell zu groß für den Bauraum oder beschädigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slicing failed. Often the model is larger than the build volume or broken."
          }
        }
      }
    },
    "errThingiverse": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Thingiverse muss auf dem Server ein Thingiverse-Token eingetragen sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thingiverse needs a Thingiverse token in the server configuration."
          }
        }
      }
    },
    "errTimeout": {
      "localizations": {
        "de": {
