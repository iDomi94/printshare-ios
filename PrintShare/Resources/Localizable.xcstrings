    "bookingAsk": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„{file}“ auf {printer}: Druck abgebrochen oder Ende verpasst. Wie viel abbuchen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“{file}” on {printer}: print cancelled or its end was missed. How much should be booked?"
          }
        }
      }
    },
    "bookingWaits": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wartet auf das Druckende"
