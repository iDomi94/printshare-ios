    "timelapseAlwaysSub": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Druck mit Kamera, auch bei Drucken, die direkt am Drucker gestartet wurden (zum Beispiel aus OrcaSlicer). Vor dem Drucken lässt er sich für einen Druck abschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For every print with a camera, also prints started on the printer itself (for example from OrcaSlicer). You can still switch it off for one print before printing."
          }
        }
      }
    },
