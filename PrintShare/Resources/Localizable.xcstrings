    "manyfoldHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse deines Manyfold (z. B. http://192.168.1.20:3214) und ein API-Key (in Manyfold: dein Name → API-Keys, Bereich „read“). Der PocketPrint3D-Server prüft beides und lädt die Modelle direkt von dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address of your Manyfold (e.g. http://192.168.1.20:3214) and an API key (in Manyfold: your name → API keys, scope “read”). The PocketPrint3D server checks both and loads the models straight from there."
          }
        }
      }
    },
