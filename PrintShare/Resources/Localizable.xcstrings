        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending to the printer didn't work:"
          }
        }
      }
    },
    "errServerOld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein PocketPrint3D-Server kennt diese Funktion noch nicht. Aktualisiere ihn auf die neueste Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PocketPrint3D server does not have this feature yet. Update it to the latest version."
          }
        }
      }
    },
    "errSession": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Anmeldung ist abgelaufen – bitte unter Einstellungen neu anmelden."
