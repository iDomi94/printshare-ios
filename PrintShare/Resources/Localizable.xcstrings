    "bridgeCodeHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code steht auf der Seite der Brücke (Raspberry Pi: http://pocketprint3d.local), im Protokoll des Containers bzw. auf der Seite des Add-ons und gilt 10 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is on the bridge's page (Raspberry Pi: http://pocketprint3d.local), in the container's log or on the add-on's page, and is valid for 10 minutes."
          }
        }
      }
    },
