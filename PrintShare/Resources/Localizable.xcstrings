        }
      }
    },
    "errPrinterOffline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Drucker ist nicht erreichbar. Ist er eingeschaltet und im Netz?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The printer is not reachable. Is it switched on and on the network?"
          }
        }
      }
    },
    "errPrinterOfflineLan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht erreichbar. Ist das Handy im selben WLAN wie der Drucker und der Drucker eingeschaltet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
