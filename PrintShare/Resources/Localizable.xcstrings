    "orcaCloudHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Link eines öffentlichen Bundles von cloud.orcaslicer.com einfügen – Drucker-, Qualitäts- und Materialprofile werden übernommen, ohne Orca-Konto. Private Bundles lassen sich nur mit Orca-Anmeldung lesen: dann die Profile in OrcaSlicer exportieren und unten hochladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the link of a public bundle on cloud.orcaslicer.com – printer, quality and material profiles are imported, no Orca account needed. Private bundles need an Orca login: export the presets in OrcaSlicer and upload the file below instead."
          }
