    "orcaPrintNote": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Hochladen und drucken“ startet sofort, wenn der Drucker über eine Brücke erreichbar ist (gebucht wird die zuletzt benutzte Spule). Sonst liegt der Druck bereit und du startest ihn in der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Upload and print” starts right away when the printer is reached through a bridge (the spool used last is booked). Otherwise the print waits and you start it in the app."
          }
        }
      }
    },
