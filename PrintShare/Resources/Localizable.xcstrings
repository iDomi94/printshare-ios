    },
    "errBridgeOffline": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Brücke ist offline – läuft dein Server zu Hause?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge is offline – is your server at home running?"
          }
        }
      }
