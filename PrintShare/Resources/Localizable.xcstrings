    "orcaHowTo": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Neben dem Drucker das WLAN-Symbol antippen (Physischen Drucker hinzufügen).\n2. Host-Typ: Octo/Klipper.\n3. Hostname, IP oder URL: die Adresse von oben.\n4. API-Key: der Key von oben.\n5. „Test“ – OrcaSlicer meldet die Verbindung als erfolgreich.\nDanach nach dem Slicen „Hochladen“ oder „Hochladen und drucken“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Click the Wi-Fi icon next to the printer (Add physical printer).\n2. Host type: Octo/Klipper.\n3. Hostname, IP or URL: the address above.\n4. API key: the key above.\n5. “Test” – OrcaSlicer reports the connection as successful.\nAfter slicing, use “Upload” or “Upload and print”."
          }
        }
      }
    },
    "orcaIntro": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Druckst du am Computer mit OrcaSlicer? Dann schickt OrcaSlicer den G-Code für „{printer}“ über PocketPrint3D: er erscheint hier als Auftrag (Vorschau, Spulen, Drucken) und die Spule wird gebucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you print from OrcaSlicer on your computer? Then OrcaSlicer sends the G-code for “{printer}” through PocketPrint3D: it shows up here as a job (preview, spools, print) and the spool is booked."
          }
        }
      }
    },
    "orcaKey": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Key (antippen zum Kopieren)"
