    "cameraDenied": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist ausgeschaltet. Du kannst ihn in den Einstellungen erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is turned off. You can allow it in Settings."
          }
        }
      }
    },
    "cameraNeeded": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Scannen braucht PrintShare einmalig Zugriff auf die Kamera."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PrintShare needs camera access once to scan the code."
          }
        }
      }
    },
    "cameraUnreachable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera nicht erreichbar. Das Bild kommt direkt vom Drucker und geht nur im Heimnetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera not reachable. The picture comes straight from the printer and only works at home."
          }
        }
