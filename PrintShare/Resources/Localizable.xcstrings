    "bambuCode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Access Code"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access code"
          }
        }
