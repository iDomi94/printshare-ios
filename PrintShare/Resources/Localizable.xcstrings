    "makerworldText": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerWorld lässt sich nicht von außen durchsuchen. Öffne ein Modell in der MakerWorld-App oder im Browser und schick es über „Teilen → PocketPrint3D“ hierher – oder füge den Link oben ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MakerWorld can't be searched from outside. Open a model in the MakerWorld app or your browser and send it here with “Share → PocketPrint3D” – or paste the link above."
          }
        }
      }
    },
