    "orcaSteps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So geht's in OrcaSlicer"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to set it up in OrcaSlicer"
          }
        }
      }
    },
    "orcaTitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus OrcaSlicer senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send from OrcaSlicer"
          }
        }
      }
    },
    "orcaUrl": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse (antippen zum Kopieren)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address (tap to copy)"
          }
        }
      }
    },
    "orcaWhy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OrcaSlicer erreicht deinen Drucker oft auch direkt – dann geht der Druck aber an PocketPrint3D vorbei. Über PocketPrint3D:\n• Die Spulen stimmen: das Filament wird gebucht wie bei jedem anderen Druck.\n• Von überall: am Laptop slicen, zu Hause druckt es – über deine Brücke.\n• Ein Überblick: der Druck erscheint in App und Browser, mit Vorschau, Fortschritt und Kamera.\n• Erst prüfen, später starten: „Hochladen“ legt den Druck bereit, du startest ihn am Handy und wählst Spule und Slot."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OrcaSlicer can often reach your printer directly – but then the print bypasses PocketPrint3D. Through PocketPrint3D:\n• Spools stay right: the filament is booked like for every other print.\n• From anywhere: slice on the laptop, the printer at home prints – through your bridge.\n• One overview: the print shows up in the app and the browser, with preview, progress and camera.\n• Check first, start later: “Upload” gets the print ready, you start it on your phone and choose spool and slot."
          }
        }
      }
    },
    "orcaWhyNot": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Spulen und nur zu Hause? Dann ist direktes Senden aus OrcaSlicer genauso gut. In OrcaSlicer bekommt dein echter Drucker nur einen anderen Weg – über PocketPrint3D."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No spools and only printing at home? Then sending directly from OrcaSlicer is just as good. In OrcaSlicer your real printer only gets another way – through PocketPrint3D."
          }
        }
      }
    },
    "orcaWhyTitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum über PocketPrint3D?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why through PocketPrint3D?"
          }
        }
      }
    },
    "otherEmail": {
      "localizations": {
        "de": {
          "stringUnit": {
