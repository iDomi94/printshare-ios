    "bambuHint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Drucker unter Einstellungen → WLAN „LAN Only Mode“ einschalten, bei neuerer Firmware zusätzlich „Developer Mode“ (erscheint darunter) – dort steht auch der Access Code (8 Zeichen). Ohne LAN-Modus nimmt der Drucker keine Druckaufträge an. Hinweis: Im LAN-Modus ist der Drucker nicht mehr mit der Bambu-Cloud verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the printer, under Settings → WLAN, switch on “LAN Only Mode”, and with newer firmware also “Developer Mode” (shown below it) – the access code (8 characters) is there too. Without LAN mode the printer takes no print jobs. Note: in LAN mode the printer is no longer connected to the Bambu cloud."
          }
        }
      }
    },
