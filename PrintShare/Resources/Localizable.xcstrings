    "bridgeLanNone": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Brücke im WLAN gefunden. Ist der Raspberry Pi eingesteckt und per LAN-Kabel am Router? Nach dem ersten Einschalten dauert es etwa 3 Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bridge found on your Wi-Fi. Is the Raspberry Pi plugged in and connected to the router with a network cable? After the first start it takes about 3 minutes."
          }
        }
      }
    },
