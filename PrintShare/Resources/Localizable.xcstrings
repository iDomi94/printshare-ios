      }
    },
    "warnPlatePetg": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PETG kann auf glatter PEI zu stark haften. Texturierte PEI oder Kleber verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PETG can bond too strongly to smooth PEI. Use Textured PEI or glue."
          }
        }
      }
    },
    "warnPlatePla": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
